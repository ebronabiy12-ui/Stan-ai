# STAN_API_URL: URL of the Python FastAPI STAN AI inference service.
# Express proxies /api/stan/* to this URL.
STAN_API_URL="http://127.0.0.1:8001"

# STAN_AUTO_SPAWN: Set to "false" to disable auto-spawning local uvicorn from server.ts.
STAN_AUTO_SPAWN="true"

# VITE_STAN_API_URL: Optional browser-facing base path (defaults to /api/stan proxy).
VITE_STAN_API_URL="/api/stan"

# APP_URL: Hosted application URL injected at runtime.
APP_URL="MY_APP_URL"
